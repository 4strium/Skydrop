---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import ClientsSection from "@components/sections/landing/ClientsSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import heroImage from "@images/drone-home.png";
import faqs from "@data/faqs.json";
import features from "@data/features.json";
import featureImage from "@images/features-image.avif";
import features_0 from "@images/drones_features_0.png";
import features_1 from "@images/ecolo_features_1.png";
import features_2 from "@images/tower_features_2.jpg";
import samuel_img from "@images/samuel.png";
import { partnersData } from "@/data_files/constants";

const avatarSrcs: Array<string> = [
  "https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
  "https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
  "https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80",
  "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
];
---

<MainLayout>
  <HeroSection
    title=`Débattre l'utilisation des drones avec <span
        class="text-yellow-500 dark:text-yellow-400">Skydrop</span>`
    subTitle="Nous repensons le déploiement de la livraison par drone en France."
    primaryBtn="Nos débats"
    primaryBtnURL="/blog"
    withReview={false}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.8</span> / 5`
    starCount={4}
    reviews=`From Over <span class="font-bold">12.8k</span> Reviews`
    src={heroImage}
    alt="Stack of ScrewFast product boxes containing assorted hardware tools"
  />

  <FeaturesGeneral
    title="Conférences de consensus"
    subTitle="Skydrop est une organisation non gouvernementale qui a réalisé une conférence de consensus en France pour établir des préconisations et des études d'impacts vis-à-vis de la mise sur le marché de solutions de livraison aérienne par drones automatisés."
    features={features}
  />

  <FeaturesNavs
    title=`<span class="text-yellow-500 dark:text-yellow-400">Skydrop</span> arrive à mettre autour de la même table de discussions des acteurs que pourtant tout oppose.`
    tabs={[
      {
        heading: "Les leaders de la logistique",
        content:
          "En 2024, 1.7 milliards de colis ont été distribués en France, c'est donc un marché en pleine expansion qui ne demande qu'à s'ouvrir vers de nouvelles techniques permettant de répondre à la demande.",
        svg: "box",
        src: features_0,
        alt: "Yellow and black heavy equipment on brown grass field",
        first: true,
      },
      {
        heading: "Les défenseurs de l'environnement",
        content:
          "25 % du CO2 émis en ville provient du transport de marchandises. Cela s'explique par le fait que le coût environnemental de vos livraisons repose à 40% sur le dernier kilomètre. Il convient donc de réduire l'impact final.",
        svg: "plant",
        src: features_1,
        alt: "A screenshot or graphic representation of the intuitive dashboard",
      },
      {
        heading: "Les contrôleurs de l'espace aérien civil ou militaire",
        content:
          "La prolifération des drones professionnels ou de loisirs complexifie la gestion des espaces aériens. En 2025, une véritable psychose s'est installé en Europe lorsque des possibles drones ont été repéré à proximité d'aéroports d'envergure. Cela démontre bien le besoin de légiférer pour éviter des interruptions prolongées.",
        svg: "plane",
        src: features_2,
        alt: "Gray metal building frame near tower crane during daytime",
      },
    ]}
  />

  <TestimonialsSection
    title="Comprendre les enjeux"
    subTitle="Skydrop organise des discussions enrichissantes pour l'ensemble des intervenants. Bien souvent, nos membres développent un sens critique vis-à-vis du sujet étudié."
    ;
    testimonials={[
      {
        content:
          "Bien que Skydrop ait comme but principal de rendre un avis pertinent sur la livraison par drone. Rencontrer des français de différents horizons m'a permis d'intégrer leurs doutes et leurs inquiétudes au processus de recherche et développement de nos engins.",
        author: "Samuel Ruiz",
        role: "Directeur technique | Udrone",
        avatarSrc:
          samuel_img,
      },
    ]}
    statistics={[
      {
        count: "72 %",
        description:
          "des personnes interrogées se disent « très préoccupées » par l’utilisation de drones aériens autour de leur domicile.",
      },
      {
        count: "8min",
        description:
          "Temps de livraison via drone, au lieu de 30 minutes par véhicule terrestre.",
      },
      {
        count: "69dB",
        description:
          "Niveau auditif à 15m mesuré lors de livraisons par drone en Australie.",
      },
      {
        count: "20 000 €",
        description: "Prix du drone DJI Flycart 30, largement utilisé par les industriels du secteur.",
      },
    ]}
  />

  <FAQ title="Questions<br />souvent posées" faqs={faqs} />

</MainLayout>
