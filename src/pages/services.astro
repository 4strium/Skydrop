---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import blueprints from "@images/timeline.png";
import personWorking from "@images/convention.png";
import beforeAfter from "@images/Decision finale.png";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/Logo.png";
import zipline0 from "@images/zipline-0.png";
import walmartwing from "@images/walmart-wing.png";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Déroulement conference de consensus",
    subTitle:
      "Pendant six mois, 36 personnes venant de différentes régions ont débattu sur les drones livreurs. Cependant pour pouvoir débattre elles ont d'abord étudié le sujet a l'aide de formateur venu de milieu different. Ces differents formateurs ont aider a nos conferenciers de se faire une opinion sur les drones livreurs et en conclusion de pouvoir rendre un compte rendu dessus qui sera lu par le parlement et le sénat (et non pas par le président seulement). En esperant aboutir sur une reglementation  .",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Blueprints and digital tablet with construction plans.",
    imgTwo: personWorking,
    imgTwoAlt: "Person working in the office",
  },
  {
    isRightSection: false,
    title: "Les Avis",
    subTitle:
      "Nos conférenciers ont passé plus de 400 heures à débattre sur un sujet qui nous concerne tous : les drones livreurs. Les avis au cours de ce débat ont été très nuancés. Au fil des échanges, de nombreuses problématiques ont émergé, contrastant avec les avantages indéniables de cette technologie. Beaucoup de conférenciers voyaient l'aspect écologique de cette technologie, notamment de la production de batterie qui est un sujet très controversé de nos jours. D'autre personne ont pensé au personnes qui pourraient en bénéficier, en particulier les personnes a mobilité réduite qui bénéficierais de ce système même dans des coins plus reculés. Enfin on a pu débattre sur les dégâts probables sur la faune principalement les oiseaux.", 
    img: beforeAfter,
    imgAlt: "Construction site before and after",
    btnExists: false,
  },
  {
    isRightSection: true,
    title: "Navigating Projects with Professional Oversight",
    subTitle:
      "Effective project management is at the heart of any successful build. ScrewFast provides thorough planning and robust management services that keep your project on time and within budget. Let us handle the complexities of workflow coordination, resource allocation, and stakeholder communication while you focus on your vision.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Construction workers orchestrating a project",
    imgTwo: aerialView,
    imgTwoAlt: "Aerial view of managed construction",
  },
  {
    isRightSection: false,
    title: "Ensuring Long-lasting Performance",
    subTitle:
      "Our commitment to your project doesn't end at completion. ScrewFast offers ongoing maintenance and support services to ensure your construction's longevity and performance. From regular check-ups to emergency assistance, our responsive team is there to provide seamless support.",
    img: usingTools,
    imgAlt:
      "Man in orange and black vest wearing white helmet holding yellow and black power tool",
  },
  {
    isRightSection: true,
    title: "Des études de cas ciblées",
    subTitle:
      "Afin de parfaitement saisir les enjeux relatifs à la livraison par drone, il convient d'étudier des solutions déjà mises en place dans d'autres pays. Nos membres ont par ailleurs réfléchi aux possibilités de transposer certaines solutions à notre pays.",
    single: false,
    imgOne: zipline0,
    imgOneAlt: "In progress building structure",
    imgTwo: walmartwing,
    imgTwoAlt: "Brown and gray building under construction",
    btnExists: true,
    btnTitle: "Voir plus",
    btnURL: "insights/insight-1/",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  "Uniting expertise with your vision, ScrewFast provides exceptional service and comprehensive solutions in the hardware and construction industry, from consultation to project completion.";
const ogTitle = "Expert Consultation Services | ScrewFast";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://screwfast.uk/services",
    url: "https://screwfast.uk/services",
    name: "Expert Consultation Services | ScrewFast",
    description:
      "Uniting expertise with your vision, ScrewFast provides exceptional service and comprehensive solutions in the hardware and construction industry, from consultation to project completion.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://screwfast.uk",
      name: "ScrewFast",
      description:
        "ScrewFast offers top-tier hardware tools and expert construction services to meet all your project needs.",
    },
    inLanguage: "en-US",
  }}
>
  {/* MainSection is the introductory section of the page, it also contains a CTA button */}
  <MainSection
    title="Notre conférence de consensus en détails"
    subTitle="Voici quelques informations supplémentaires qui vous permettront de vous plonger dans l'univers de nos discussions."
    btnExists={false}
    btnTitle="Schedule a Consultation"
    btnURL="#"
  />
  {/* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */}
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="Les nombres clés"
    subTitle="Ce projet sert à montrer que tout est débattable, et que même en étant un citoyen, on peut donner son avis sur une technologie de pointe."
    mainStatTitle="36"
    mainStatSubTitle="Personnes ont débattu pendant 6 mois sur les drones livreurs "
    stats={[
      {
        stat: "400h + ",
        description: "de débat en salle",
      },
      {
        stat: "5,000+",
        description: "successful installations",
      },
      {
        stat: "85%",
        description: "client growth year-over-year",
      },
    ]}
  />
</MainLayout>
